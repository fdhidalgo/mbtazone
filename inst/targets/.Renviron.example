# Copy to the package root as `.Renviron` (gitignored) or to ~/.Renviron, then set absolute paths.
# All three variables are required for inst/targets/_targets.R (parcel MCMC pipeline).

# Directory containing per-municipality .gpkg files from the mbta-data-pipeline
MBTAZONE_PIPELINE_DATA=/path/to/mbta_pipeline_data

# Absolute path to the statewide right-of-way shapefile
MBTAZONE_RIGHT_OF_WAY=/path/to/Excluded_Land_Right_of_Way.shp

# Absolute path to the state-provided Gross Density Denominator Deductions shapefile
# Download from: EOHLC "Compliance Model & Components" > "Reference and calculation layers"
MBTAZONE_DENSITY_DEDUCTIONS=/path/to/Density_Denominator_Deductions.shp

# Optional — inst/targets/run_all_districts.R when not run from package root
# MBTAZONE_PACKAGE_ROOT=/path/to/mbtazone
